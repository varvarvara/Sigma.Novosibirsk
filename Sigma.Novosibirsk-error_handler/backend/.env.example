POSTGRES_DB=sigma
POSTGRES_USER=sigma
POSTGRES_PASSWORD=sigma
POSTGRES_PORT=5433

DATABASE_URL=postgresql://sigma:sigma@localhost:5433/sigma

APP_ENV=dev
JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=7
REMEMBER_REFRESH_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60
FRONTEND_APP_URL=http://localhost:5173

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# For production set false
OPENAPI_ENABLED=true

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380/0

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=no-reply@example.com
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

S3_ENDPOINT_URL=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET_NAME=bucket-name
S3_ACCESS_KEY=tenant_id:key_id
S3_SECRET_KEY=key_secret
# Оставьте пустым для приватного бакета (API отдаёт presigned URL). Заполняйте только если объекты публичные.
S3_PUBLIC_BASE_URL=
# Optional alternative to S3_ACCESS_KEY:
# S3_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# S3_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_AUTO_CREATE_BUCKET=false
CERTIFICATES_FOLDER=certificates
MEDIA_FOLDER=media
PROFILES_FOLDER=profiles

APP_TIMEZONE=Europe/Moscow
