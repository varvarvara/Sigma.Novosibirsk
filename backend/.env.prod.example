APP_ENV=prod

# REG.RU PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=7
REMEMBER_REFRESH_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60

FRONTEND_APP_URL=http://SERVER_IP
CORS_ALLOW_ORIGINS=http://SERVER_IP
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# Set false if API docs must be hidden in production.
OPENAPI_ENABLED=true

REDIS_URL=redis://redis:6379/0

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=no-reply@example.com
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

S3_ENDPOINT_URL=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET_NAME=bucket-name
S3_ACCESS_KEY=tenant_id:key_id
S3_SECRET_KEY=key_secret
S3_PUBLIC_BASE_URL=
S3_AUTO_CREATE_BUCKET=false

APP_TIMEZONE=Europe/Moscow
CERTIFICATES_FOLDER=certificates
MEDIA_FOLDER=media
PROFILES_FOLDER=profiles

